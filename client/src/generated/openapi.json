    "/events": {
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Ingest Event",
        "description": "Ingest a single domain event and return emitted notification IDs.",
        "operationId": "ingest_event_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/QueueSnapshotEvent"
                  },
                  {
                    "$ref": "#/components/schemas/AgentStateChangeEvent"
                  },
                  {
                    "$ref": "#/components/schemas/AdherenceCheckEvent"
                  }
                ],
                "title": "Event",
                "discriminator": {
                  "propertyName": "type",
                  "mapping": {
                    "queue_snapshot": "#/components/schemas/QueueSnapshotEvent",
                    "agent_state_change": "#/components/schemas/AgentStateChangeEvent",
                    "adherence_check": "#/components/schemas/AdherenceCheckEvent"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestEventResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
